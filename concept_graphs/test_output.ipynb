    "os.makedirs(folder_path, exist_ok=True)\n",
    "\n",
    "#stored_ep = [99, 199, 299, 399, 499]\n",
    "stored_ep = [399]\n",
    "\n",
    "for ep in stored_ep:\n",
    "#for ep in [3,4,9]:\n",
    "    for idx, config in enumerate(configs):\n",
    "        print(ep)\n",
    "        print(config)\n",
    "        #print(descrips[idx])\n",
    "        file_path = folder_path + f\"/image_{config}_ep{ep}.npz\"\n",
    "\n",
    "        # Load the .npz file\n",
    "        data = np.load(file_path)\n",
    "\n",
    "        # List all arrays in the file\n",
    "        keys = data.files\n",
    "        #print(\"Keys in NPZ file:\", keys)\n",
    "\n",
    "        # Plot a few images from each array\n",
    "        for key in keys:\n",
    "            images = data[key] \n",
    "            print(f\"Shape of {key}:\", images.shape)\n",
    "\n",
    "            # Loop through the first batch and first few images\n",
    "            for i in range(1):  # Display 5 images\n",
    "                # img = images[0, i]  # First batch, ith image (Shape: 3, 28, 28)\n",
    "                img = images[i] # ith image (Shape: 3, 28, 28)\n",
    "                #print(img.max())\n",
    "                #print(img.min())\n",
    "\n",
    "                # Transpose to (28, 28, 3) for imshow\n",
    "                img = np.transpose(img, (1, 2, 0))\n",
    "                # img = (img +1) /2\n",
    "                img = img.clip(0, 1)\n",
    "                \n",
    "                plt.figure()\n",
    "                plt.title(f\"{key} - Image {i+1}\")\n",
    "                plt.imshow(img)\n",
    "                plt.axis('off')\n",
    "\n",
    "                #plt.savefig(f\"/data2/amanda/LLM-Understanding/concept_graphs/output/single-body_2d_3classes/seed={seed}/H32-train1/{category_config}/image_{config}_ep{ep}.png\", bbox_inches=\"tight\")\n",
    "\n",
    "        plt.show()\n",
    "\n",
    "        # Close the file\n",
    "        data.close()\n"
   ]
